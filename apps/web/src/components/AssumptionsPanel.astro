---
import type { Assumptions } from '@rich-sim/core';
import { formatRate } from '../lib/assumptions';
import { DEFAULT_ASSUMPTIONS } from '../lib/defaults';
import { type Locale } from '../lib/i18n';
import { format, t } from '../lib/messages';

/**
 * T09 · 假设清单 + 免责声明面板（纯 Astro SSR，零客户端 JS）。
 *
 * 红线（CONVENTIONS §红线 / PRD §9）：假设清单与免责声明必须在服务端
 * 渲染、页面源码可见，不被客户端 JS 关掉。本组件不挂载任何 client:* 指令，
 * 输出的纯静态 HTML 即全部内容——即便 JS 被禁用或岛加载失败，合规文案
 * 依然存在于首屏。
 *
 * 也正因为它是合规文本，locale 必须在 **SSR 期**就生效（由页面传入，
 * 不由客户端改写）：英文页面配中文免责声明等于没展示。
 *
 * props.assumptions 默认取 DEFAULT_ASSUMPTIONS（冻结）。汇率来源与日期
 * 必须展示（币种口径约定），否则视为不达标。
 *
 * **`data-assumption` 是给客户端增强留的钩子**：SSR 只能印默认值，而
 * `AssumptionsEditor`（结果页）与设计器岛会把用户真正在用的那套数值改写进
 * 这几个节点（`lib/assumptions.ts` 的 `patchAssumptionDisplay`）。钩子留在
 * 服务端 HTML 上、改写只动文本，所以关 JS 时这份清单仍是完整的一屏。
 */

interface Props {
  assumptions?: Assumptions;
  locale?: Locale;
}

const { assumptions = DEFAULT_ASSUMPTIONS, locale = 'zh' } = Astro.props;
const a = assumptions;

const fx = a.fx;
const cnyRate = fx.rates['CNY'];
const eurRate = fx.rates['EUR'];
const cnyText = Number.isFinite(cnyRate) ? cnyRate.toFixed(2) : '—';
const eurText = Number.isFinite(eurRate) ? eurRate.toFixed(2) : '—';
---

<aside
  data-compliance
  class="mt-10 border-t border-line pt-6 text-xs leading-relaxed text-muted"
>
  <section aria-labelledby="assumptions-heading">
    <h2 id="assumptions-heading" class="mb-2 text-[13px] font-medium text-ink">{t('assumptions.title', locale)}</h2>
    <dl class="grid grid-cols-1 gap-x-6 gap-y-1.5 sm:grid-cols-2">
      <div class="flex justify-between gap-3">
        <dt>{t('assumptions.returnRate', locale)}</dt>
        <dd data-assumption="returnRate" class="font-mono tabular-nums text-ink">{formatRate(a.returnRate)}</dd>
      </div>
      <div class="flex justify-between gap-3">
        <dt>{t('assumptions.withdrawalRate', locale)}</dt>
        <dd data-assumption="withdrawalRate" class="font-mono tabular-nums text-ink">{formatRate(a.withdrawalRate)}</dd>
      </div>
      <div class="flex justify-between gap-3">
        <dt>{t('assumptions.inflation', locale)}</dt>
        <dd data-assumption="inflation" class="font-mono tabular-nums text-ink">{formatRate(a.inflation)}</dd>
      </div>
      <div class="flex justify-between gap-3">
        <dt>{t('assumptions.version', locale)}</dt>
        <dd class="font-mono tabular-nums text-ink">v{a.assumptionsVersion}</dd>
      </div>
    </dl>
    <p class="mt-2">
      {format(t('assumptions.fxLine', locale), {
        base: fx.base,
        cny: cnyText,
        eur: eurText,
        source: fx.source,
        date: fx.date,
      })}
    </p>
  </section>

  <section aria-labelledby="disclaimer-heading" class="mt-5 border-t border-line pt-4">
    <h2 id="disclaimer-heading" class="mb-2 text-[13px] font-medium text-ink">{t('assumptions.disclaimerTitle', locale)}</h2>
    <ul class="list-disc space-y-1 pl-4">
      <li>{t('assumptions.disclaimer1', locale)}</li>
      <li>{t('assumptions.disclaimer2', locale)}</li>
      <li>{t('assumptions.disclaimer3', locale)}</li>
      <li>{t('assumptions.disclaimer4', locale)}</li>
      <li>{t('assumptions.disclaimer5', locale)}</li>
    </ul>
  </section>
</aside>
