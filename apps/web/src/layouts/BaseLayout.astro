---
/**
 * B1 · 全站基础布局（PWA）。
 *
 * - 统一 <head>：charset / viewport / title / description / manifest /
 *   theme-color（深浅双模式）/ 图标 / apple 主屏元信息；
 * - 注册 /sw.js（离线回退 + 静态资产缓存，见 public/sw.js）；
 * - global.css 只在此处引入一次。
 * 页面主体（<main> 与内边距差异）由各页通过默认 slot 自行渲染。
 */
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { HTML_LANG, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  /** 页面语言；由页面用 localeFromRequest 解析后传入（SSR 期就得知道，见 lib/i18n.ts）。 */
  locale?: Locale;
}

const {
  title,
  description = '先看见富人生活的真实成本，再用你自己的收入算清够用线、差距与年限。财商模拟教育工具，不构成投资建议。',
  locale = 'zh',
} = Astro.props;

// Astro.canonicalURL is undefined under SSR, so build it from the configured
// origin. An empty href would self-canonicalize, which is worse than omitting.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- 分享门面（G2 · 2026-10-10）：OG + Twitter Card，图片 = public/og-cover.png -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="rich-sim · 财富模拟" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {Astro.site && <meta property="og:image" content={new URL('/og-cover.png', Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {Astro.site && <meta name="twitter:image" content={new URL('/og-cover.png', Astro.site).href} />}

    <!-- PWA (B1) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f7f8" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="财富模拟" />
  </head>
  <body class="min-h-dvh bg-canvas text-ink">
    <a class="skip-link" href="#main">跳到主要内容</a>
    <slot />

    <!-- M5-G3 · 隐私政策入口（有账号体系就必须随时可达） -->
    <footer class="mx-auto max-w-3xl px-4 pb-6 text-center">
      <a href="/privacy" class="text-xs text-muted underline-offset-2 hover:underline">
        {locale === 'zh' ? '隐私政策' : 'Privacy Policy'}
      </a>
    </footer>

    <!-- B2 真实上报：未配置环境变量时零输出（见 Analytics.astro） -->
    <Analytics />

    <!-- 注册 service worker：失败静默，绝不阻塞页面（SSR 安全，is:inline 不打包） -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
