---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContinueDraft from '../components/ContinueDraft.tsx';
---

<BaseLayout title="财富模拟 · rich-sim">
  <main id="main" class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-xs font-medium uppercase tracking-widest text-accent">rich-sim · 财富模拟</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">先看见，再算清。</h1>
    <p class="mt-3 text-base leading-relaxed text-muted">
      设计你的理想生活，再用你自己的收入算出够用线、差距和年限。
    </p>
    <a
      href="/app/designer"
      class="mt-8 inline-flex min-h-11 items-center rounded-full bg-accent px-5 py-3 text-sm font-semibold text-on-accent"
    >
      开始设计理想生活 →
    </a>
    <ContinueDraft client:load />
  </main>
</BaseLayout>
