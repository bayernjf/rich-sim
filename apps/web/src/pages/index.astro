---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>财富模拟 · rich-sim</title>
  </head>
  <body class="min-h-dvh bg-canvas text-ink">
    <main class="mx-auto max-w-3xl px-4 py-16">
      <p class="text-xs font-medium uppercase tracking-widest text-accent">rich-sim · 财富模拟</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight">先看见，再算清。</h1>
      <p class="mt-3 text-base leading-relaxed text-muted">
        设计你的理想生活，再用你自己的收入算出够用线、差距和年限。
      </p>
      <a
        href="/app/designer"
        class="mt-8 inline-flex rounded-full bg-accent px-5 py-3 text-sm font-semibold text-on-accent"
      >
        开始设计理想生活 →
      </a>
    </main>
  </body>
</html>
