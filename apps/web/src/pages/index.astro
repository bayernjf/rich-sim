---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContinueDraft from '../components/ContinueDraft.tsx';
import ClaimMillion from '../components/ClaimMillion';
import LocaleSwitcher from '../components/LocaleSwitcher';
import { initialCatalogUSD } from '@rich-sim/core';
import { DEFAULT_ASSUMPTIONS } from '../lib/defaults';
import { SIM_CAPITAL_TIERS, claimBillRows } from '../lib/sim-content';
import { localeFromRequest } from '../lib/i18n';
import { t } from '../lib/messages';

// §6 开关：未配置 PUBLIC_HOMEPAGE_CLAIM 时，这一屏必须完全不存在，
// 且首页 HTML 与改动前逐字节相同（验收 #2）——所以下面那段连换行都不留，
// 加在 ContinueDraft 同一行的末尾。
const claimEnabled = import.meta.env.PUBLIC_HOMEPAGE_CLAIM === '1';
const locale = localeFromRequest(Astro.request, Astro.url);
const claimRows = claimEnabled
  ? claimBillRows(initialCatalogUSD, DEFAULT_ASSUMPTIONS, locale)
  : [];
---

<BaseLayout title={t('home.metaTitle', locale)} locale={locale}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-16">
    <div class="mb-4 flex items-center justify-end gap-2">
      <LocaleSwitcher client:load locale={locale} />
    </div>
    <p class="text-xs font-medium uppercase tracking-widest text-accent">{t('home.eyebrow', locale)}</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">{t('home.h1', locale)}</h1>
    <p class="mt-3 text-base leading-relaxed text-muted">
      {t('home.sub', locale)}
    </p>
    <a
      href="/app/designer"
      class="mt-8 inline-flex min-h-11 items-center rounded-full bg-accent px-5 py-3 text-sm font-semibold text-on-accent"
    >
      {t('home.cta', locale)}
    </a>
    <ContinueDraft client:load locale={locale} />{claimEnabled && (<ClaimMillion client:load locale={locale} tiers={SIM_CAPITAL_TIERS} rows={claimRows} withdrawalRate={DEFAULT_ASSUMPTIONS.withdrawalRate} />)}
  </main>
</BaseLayout>
