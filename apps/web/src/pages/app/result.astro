---
import ResultsView from '../../components/ResultsView';
import ScenarioPanel from '../../components/ScenarioPanel';
import SavedPlans from '../../components/SavedPlans';
import ReportView from '../../components/ReportView';
import AssumptionsEditor from '../../components/AssumptionsEditor';
import LocaleSwitcher from '../../components/LocaleSwitcher';
import AuthButton from '../../components/AuthButton';
import SyncBridge from '../../components/SyncBridge';
import AssumptionsPanel from '../../components/AssumptionsPanel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { initialCatalogUSD } from '@rich-sim/core';
import { localeFromRequest } from '../../lib/i18n';
import { t } from '../../lib/messages';
import { DRAFT_KEY } from '../../lib/draft';

const locale = localeFromRequest(Astro.request, Astro.url);
---

<BaseLayout
  title={t('result.metaTitle', locale)}
  description={t('result.metaDesc', locale)}
  locale={locale}
>
  {/*
    CLS 预留（PRD §9 预算 0.1）：本页的数字全靠 localStorage，服务端一无所知，
    所以 SSR 只能印一个「正在计算」占位，hydration 后整屏撑开——位移曾把合规
    面板推下去 3.6 屏。**首帧之前**同步读一次本机草稿（只看 profile 存不存在，
    不取值、不上传），给 <html> 打上标记，让 CSS 在绘制前就预留好对应高度。
    没有 JS 时标记不存在，也就没有预留——那种情况下本来也不存在 hydration 位移。
  */}
  <script is:inline slot="head" define:vars={{ draftKey: DRAFT_KEY }}>
    try {
      var raw = localStorage.getItem(draftKey);
      var draft = raw ? JSON.parse(raw) : null;
      document.documentElement.dataset.plan = draft && draft.profile ? 'full' : 'empty';
    } catch (e) {
      document.documentElement.dataset.plan = 'empty';
    }
  </script>

  <main id="main" class="mx-auto max-w-3xl px-4 py-8">
    <div class="mb-4 flex items-center justify-end gap-2">
      <AuthButton client:load locale={locale} />
      <SyncBridge client:load />
      <LocaleSwitcher client:load locale={locale} />
    </div>

    <ResultsView catalog={initialCatalogUSD} locale={locale} client:load />

    <!-- M4 · 可调假设（PRD §6.2：提取率与 r 必须可调，不只是可看） -->
    <AssumptionsEditor locale={locale} client:load />

    <!-- M4 S1 · T02/T03 情景面板（页内岛，不新增路由） -->
    <ScenarioPanel catalog={initialCatalogUSD} locale={locale} client:load />

    <!-- F9（本机版）· 多剧本存档（页内岛，不新增路由；无草稿不渲染） -->
    <SavedPlans locale={locale} client:load />

    <!-- M4 S2 · T02/T03 报告（页内区块，不新增路由；G6 默认取页内） -->
    <ReportView catalog={initialCatalogUSD} locale={locale} client:load />

    <!-- 合规面板：纯 SSR 渲染，源码可见，不依赖客户端 JS -->
    <AssumptionsPanel locale={locale} />
  </main>
</BaseLayout>
