---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimRealityCompare from '../../components/SimRealityCompare';
import ClaimRunway from '../../components/ClaimRunway';
import ShoppingArea from '../../components/ShoppingArea';
import { dimensionLabel, optionLabel, initialCatalogUSD } from '@rich-sim/core';
import { DEFAULT_ASSUMPTIONS } from '../../lib/defaults';
import { localeFromRequest } from '../../lib/i18n';
import { format, t } from '../../lib/messages';
import {
  BILLS_PER_PAGE,
  CARD_A,
  CARD_A_ANNUAL_INCOME,
  CARD_A_BROKE,
  CARD_A_LAST_YEAR_COST,
  SELL_DISCOUNT,
  SIM_STARTING_CAPITAL,
  cardAnnualCost,
  cardBurden,
  cardBills,
  cardView,
  shoppingPool,
} from '../../lib/sim-content';

const catalog = initialCatalogUSD;
/** 页面语言在 SSR 期解析（Cookie / ?lang= / Accept-Language），与其余页同一套。 */
const locale = localeFromRequest(Astro.request, Astro.url);
const card = cardView(CARD_A, locale);
const annualCost = cardAnnualCost(CARD_A.choices, catalog, DEFAULT_ASSUMPTIONS);
const pool = shoppingPool(catalog);

const yacht = Astro.url.searchParams.get('yacht') === '1';
const simChoices = yacht ? CARD_A_BROKE : CARD_A.choices;
const simCost = cardAnnualCost(simChoices, catalog, DEFAULT_ASSUMPTIONS);
const simCashflow = CARD_A_ANNUAL_INCOME - CARD_A_LAST_YEAR_COST;
const { rate, status } = cardBurden(simChoices, catalog, DEFAULT_ASSUMPTIONS);

const bills = cardBills(simChoices, catalog, locale);
const pageCount = Math.ceil(bills.length / BILLS_PER_PAGE);
const page = Math.min(
  Math.max(Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1, 1),
  pageCount,
);
const pageBills = bills.slice((page - 1) * BILLS_PER_PAGE, page * BILLS_PER_PAGE);

const banner = {
  green: { label: t('sim.bannerGreen', locale), note: t('sim.bannerGreenNote', locale), cls: 'border-accent bg-accent-soft text-accent' },
  yellow: { label: t('sim.bannerYellow', locale), note: t('sim.bannerYellowNote', locale), cls: 'border-line bg-panel text-ink' },
  red: { label: t('sim.bannerRed', locale), note: t('sim.bannerRedNote', locale), cls: 'border-danger bg-panel text-danger' },
}[status];

const pageHref = (target: number) => `?page=${target}${yacht ? '&yacht=1' : ''}`;

const rows = CARD_A.choices.map((choice) => {
  const dimension = catalog.dimensions.find((d) => d.id === choice.dimension);
  const option = dimension?.options.find((o) => o.id === choice.optionId);
  return {
    dimensionLabel: dimension ? dimensionLabel(dimension, locale) : choice.dimension,
    optionLabel: option ? optionLabel(option, locale) : '',
    option,
  };
});

const fmt = (value: number) =>
  `$${value.toLocaleString('en-US')}`;

const assetBars = card.assetStructure.map((part, index) => ({
  ...part,
  width: `${part.share}%`,
  tone: index === 0 ? 'bg-accent' : 'bg-ink/25',
}));
---

<BaseLayout
  title={t('sim.metaTitle', locale)}
  description={t('sim.metaDesc', locale)}
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-8">
    <p class="text-xs font-medium uppercase tracking-widest text-accent">{t('sim.eyebrow', locale)}</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">{card.label}</h1>
    <p class="mt-1 text-sm leading-relaxed text-muted">{card.subtitle}</p>

    <p class="mt-3 rounded-lg border border-line bg-panel px-3 py-2 text-xs leading-relaxed text-muted">
      {card.fictionNotice}
    </p>

    <section aria-labelledby="sim-assets-heading" class="mt-8">
      <h2 id="sim-assets-heading" class="text-base font-semibold text-ink">{t('sim.assetsH', locale)}</h2>
      <div
        role="img"
        aria-label={card.assetStructure.map((part) => `${part.label} ${part.share}%`).join(locale === 'en' ? ', ' : '，')}
        class="mt-3 flex h-3 w-full overflow-hidden rounded-full"
      >
        {assetBars.map((part) => <div class={part.tone} style={`width:${part.width}`}></div>)}
      </div>
      <ul class="mt-3 space-y-1 text-sm text-muted">
        {assetBars.map((part) => (
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-2">
              <span class={`inline-block size-2 rounded-full ${part.tone}`} aria-hidden="true"></span>
              {part.label}
            </span>
            <span class="font-mono tabular-nums">{part.share}%</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="sim-cost-heading" class="mt-8">
      <h2 id="sim-cost-heading" class="text-base font-semibold text-ink">{t('sim.costH', locale)}</h2>
      <p class="mt-1 text-sm text-muted">{t('sim.costLead', locale)}</p>

      <dl class="mt-3 divide-y divide-line rounded-2xl border border-line bg-panel px-4">
        {rows.map((row) => (
          <div class="flex items-baseline justify-between gap-3 py-3">
            <dt class="text-sm text-muted">
              {row.optionLabel}
              <span class="ml-1 text-xs text-muted/70">{row.dimensionLabel}</span>
            </dt>
            <dd class="font-mono tabular-nums text-ink">
              {row.option ? fmt(row.option.annualCost) : '—'}
              {row.option?.source && (
                <a
                  class="ml-2 text-xs text-accent underline-offset-2 hover:underline"
                  href={row.option.source}
                  rel="noopener"
                >
                  {t('sim.source', locale)}
                </a>
              )}
            </dd>
          </div>
        ))}
        <div class="flex items-baseline justify-between gap-3 py-4">
          <dt class="text-sm font-semibold text-ink">{t('sim.total', locale)}</dt>
          <dd class="font-mono text-4xl font-semibold tabular-nums tracking-tight text-ink">
            {fmt(annualCost)}
          </dd>
        </div>
      </dl>

      {/* S4：领过虚拟起始金的人这里会看到「够撑多久」——没领过则整行不出现 */}
      <ClaimRunway
        client:load
        annualCost={simCost}
        initialCapital={Astro.url.searchParams.get('claim') === '1' ? SIM_STARTING_CAPITAL : null}
        locale={locale}
      />

      <p class="mt-4 text-xs leading-relaxed text-muted">
        {t('sim.costNoteA', locale)}<strong>{t('sim.costNoteBold', locale)}</strong>{t('sim.costNoteB', locale)}
      </p>
    </section>

    <section aria-labelledby="sim-bill-heading" class="mt-8">
      <h2 id="sim-bill-heading" class="text-base font-semibold text-ink">{t('sim.billH', locale)}</h2>
      <p class="mt-1 text-sm text-muted">
        {t('sim.billLead', locale)}
        {yacht ? t('sim.yachtOn', locale) : t('sim.yachtOff', locale)}
        {!yacht && (
          <a class="text-accent underline-offset-2 hover:underline" href="?yacht=1">{t('sim.yachtLink', locale)}</a>
        )}
      </p>

      <div class={`mt-3 rounded-2xl border p-4 ${banner.cls}`} role="status">
        <p class="text-sm font-semibold">
          {banner.label} · {format(t('sim.burdenRate', locale), { rate: rate === null ? '—' : `${Math.round(rate * 100)}%` })}
        </p>
        <p class="mt-1 text-xs leading-relaxed">{banner.note}</p>
        <p class="mt-2 text-xs leading-relaxed text-muted">
          {format(t('sim.cashflowLine', locale), { cost: fmt(simCost), cashflow: fmt(simCashflow) })}
          {format(t('sim.cashflowDerivation', locale), { income: fmt(CARD_A_ANNUAL_INCOME), last: fmt(CARD_A_LAST_YEAR_COST) })}
        </p>
      </div>

      {status === 'red' && (
        <p class="mt-3 rounded-lg border border-danger px-3 py-2 text-xs leading-relaxed text-danger">
          {format(t('sim.breakNote', locale), { item: bills[0]?.optionLabel ?? '', amount: fmt(Math.round((bills[0]?.annualCost ?? 0) * SELL_DISCOUNT)) })}
        </p>
      )}

      <ul class="mt-4 space-y-2">
        {pageBills.map((bill) => (
          <li class="rounded-xl border border-line bg-panel px-4 py-3">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-sm text-ink">{bill.optionLabel}</span>
              <span class="font-mono tabular-nums text-ink">{format(t('sim.perYear', locale), { amount: fmt(bill.annualCost) })}</span>
            </div>
            <div class="mt-1 flex items-baseline justify-between gap-3">
              <span class="text-xs text-muted">
                {format(t('sim.perMonth', locale), { dimension: bill.dimensionLabel, amount: fmt(bill.monthlyCost) })}
              </span>
              {bill.source && (
                <a class="text-xs text-accent underline-offset-2 hover:underline" href={bill.source} rel="noopener">
                  {t('sim.source', locale)}
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>

      {pageCount > 1 && (
        <nav aria-label={t('sim.pagerLabel', locale)} class="mt-3 flex gap-2">
          {Array.from({ length: pageCount }, (_, i) => i + 1).map((p) => (
            <a
              aria-current={p === page ? 'page' : undefined}
              class={`rounded-full px-3 py-1 text-xs ${p === page ? 'bg-ink text-canvas' : 'border border-line text-muted hover:text-ink'}`}
              href={pageHref(p)}
            >
              {format(t('sim.page', locale), { n: p })}
            </a>
          ))}
        </nav>
      )}

      <SimRealityCompare
        client:load
        locale={locale}
        bills={pageBills.map((bill) => ({ optionLabel: bill.optionLabel, annualCost: bill.annualCost }))}
      />
    </section>

    <ShoppingArea client:load items={pool} baselineAnnualCost={annualCost} locale={locale} />
    {/* S4 关 JS 降级：岛首帧为 null、无 JS 写不了购物车，给一个 SSR 可见的
        普通链接继续现实测算主线，不在此处假装有购物车目标。 */}
    <noscript>
      <section class="mt-8 rounded-2xl border border-line bg-panel p-4">
        <h2 class="text-base font-semibold text-ink">{t('sim.noscriptH', locale)}</h2>
        <p class="mt-1 text-xs leading-relaxed text-muted">
          {t('sim.noscriptBody', locale)}
        </p>
        <a
          href="/app/finance"
          class="mt-3 inline-flex min-h-11 items-center rounded-full border border-accent px-5 py-3 text-sm font-medium text-accent"
        >
          {t('sim.noscriptCta', locale)}
        </a>
      </section>
    </noscript>

    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-full border border-line-strong px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-panel-2"
    >
      {t('sim.backHome', locale)}
    </a>
  </main>
</BaseLayout>
