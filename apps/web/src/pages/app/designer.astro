---
import DesignerShell from '../../components/DesignerShell';
import AssumptionsPanel from '../../components/AssumptionsPanel.astro';
import { initialCatalogUSD } from '@rich-sim/core';
import '../../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>设计理想生活 · 财富模拟</title>
  </head>
  <body class="min-h-dvh bg-canvas text-ink">
    <main class="mx-auto max-w-3xl px-4 py-8">
      <DesignerShell catalog={initialCatalogUSD} client:load />

      <div class="mt-8">
        <a
          href="/app/finance"
          class="inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-medium text-on-accent transition-opacity hover:opacity-90 focus-visible:outline-2"
        >
          下一步：录入财务 →
        </a>
      </div>

      <!-- 合规面板：纯 SSR 渲染，源码可见，不依赖客户端 JS -->
      <AssumptionsPanel />
    </main>
  </body>
</html>
