---
import DesignerShell from '../../components/DesignerShell';
import AssumptionsPanel from '../../components/AssumptionsPanel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { initialCatalogUSD } from '@rich-sim/core';
---

<BaseLayout
  title="设计理想生活 · 财富模拟"
  description="在居住、出行、家庭等 7 个维度里选择你想要的生活，实时算出理想生活年成本。"
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-8">
    <DesignerShell catalog={initialCatalogUSD} client:load />

    <div class="mt-8">
      <a
        href="/app/finance"
        class="inline-flex min-h-11 items-center rounded-md bg-accent px-4 py-2 text-sm font-medium text-on-accent transition-opacity hover:opacity-90 focus-visible:outline-2"
      >
        下一步：录入财务 →
      </a>
    </div>

    <!-- 合规面板：纯 SSR 渲染，源码可见，不依赖客户端 JS -->
    <AssumptionsPanel />
  </main>
</BaseLayout>
